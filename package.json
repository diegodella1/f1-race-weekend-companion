{
  "name": "f1-race-weekend-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @f1/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @f1/web test:e2e",
    "audit:ui": "node scripts/audit-ui.mjs",
    "visual:capture": "node scripts/capture-visuals.mjs",
    "smoke:openf1": "tsx scripts/smoke-openf1.ts",
    "smoke:offline": "tsx scripts/smoke-offline.ts",
    "sync:season": "tsx scripts/sync-season-2026.ts"
  },
  "devDependencies": {
    "@f1/domain": "workspace:*",
    "@f1/providers": "workspace:*",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.10.3",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
