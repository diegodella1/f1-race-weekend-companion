# replay is default and needs no credentials
DATA_PROVIDER=replay
ENABLE_REPLAY=true
REPLAY_DEFAULT_SESSION=demo-race-2024
REPLAY_FIXTURE_DIR=

# OpenF1 historical data is public. Live data requires OAuth credentials.
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_USERNAME=
OPENF1_PASSWORD=
OPENF1_ACCESS_TOKEN=

# memory is supported in MVP; use a shared implementation before multi-instance live traffic
CACHE_BACKEND=memory
KV_REST_API_URL=
KV_REST_API_TOKEN=

ENABLE_LLM_EXPLAIN=false
OPENAI_API_KEY=
ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_APP_URL=http://localhost:3000
