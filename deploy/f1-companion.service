[Unit]
Description=F1 Race Weekend Companion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diego
Group=diego
WorkingDirectory=/home/diego/Documents/f1/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PORT=3463
Environment=HOSTNAME=127.0.0.1
Environment=DATA_PROVIDER=replay
Environment=ENABLE_REPLAY=true
EnvironmentFile=-/home/diego/Documents/f1/.env.production
ExecStart=/usr/bin/node apps/web/server.js
Restart=always
RestartSec=5s
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
